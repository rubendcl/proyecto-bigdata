# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Variables de entorno del proyecto BigData
# Copiar este archivo como .env y ajustar los valores:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── General ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENTORNO=desarrollo         # desarrollo | staging | produccion

# ── Apache Kafka ──────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPICO_TRANSACCIONES=transacciones-financieras
KAFKA_TOPICO_ALERTAS=alertas-fraude
KAFKA_GRUPO_CONSUMIDORES=grupo-procesamiento-bd
KAFKA_NUM_PARTICIONES=6
KAFKA_FACTOR_REPLICACION=2

# ── PostgreSQL — Data Warehouse ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bigdata_dw
POSTGRES_USER=bigdata
POSTGRES_PASSWORD=bigdata2026

# ── SeaweedFS — Data Lake (Object Storage S3-compatible, reemplaza a MinIO) ──
S3_ENDPOINT=localhost:8333
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=lakeadmin123
S3_BUCKET_RAW=zona-raw
S3_BUCKET_SILVER=zona-silver
S3_BUCKET_GOLD=zona-gold
S3_BUCKET_LAKEHOUSE=lakehouse
S3_SSL=false

# ── Apache Spark ──────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ── Recuperación ante Desastres (DRP) ─────────────────────────────────────────
RTO_OBJETIVO_MINUTOS=15
RPO_OBJETIVO_MINUTOS=5
INTERVALO_BACKUP_SEGUNDOS=300
SITIO_PRIMARIO=region-a-activa
SITIO_STANDBY=region-b-standby
SITIO_COLD=region-c-backup-frio

# ── Circuit Breaker ───────────────────────────────────────────────────────────
CB_UMBRAL_FALLOS=5
CB_TIMEOUT_SEGUNDOS=30
CB_VENTANA_FALLOS_SEGUNDOS=60

# ── Particionamiento ──────────────────────────────────────────────────────────
NUM_SHARDS=3
ESTRATEGIA_SHARD=hash           # hash | range | geografica
FACTOR_REPLICACION=2

# ── Simulador ─────────────────────────────────────────────────────────────────
PROB_FRAUDE=0.02               # 2% de transacciones con fraude
INTERVALO_STREAMING_S=0.5      # Segundos entre eventos en streaming
LOTE_BATCH_N=10000             # Tamaño del lote batch nocturno
